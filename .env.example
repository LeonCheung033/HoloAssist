# DeepSeek settings
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Vision Model settings
VISION_API_KEY=your-api-key
VISION_BASE_URL=https://api.deepseek.com/v1
VISION_MODEL=deepseek-vision

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=deepseek-coder:6.7b
OLLAMA_REASON_MODEL=deepseek-coder:6.7b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_AGENT_MODEL=deepseek-coder:6.7b

# Service selection
CHAT_SERVICE=DEEPSEEK
REASON_SERVICE=OLLAMA
AGENT_SERVICE=DEEPSEEK

# Search settings
SERPAPI_KEY=your-serpapi-key
SEARCH_RESULT_COUNT=3

# Database settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=holoassist

# Neo4j settings
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# JWT settings
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_EXPIRE=3600
REDIS_CACHE_THRESHOLD=0.8

# Embedding settings
EMBEDDING_TYPE=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_THRESHOLD=0.90

# GraphRAG settings
GRAPHRAG_PROJECT_DIR=llm_backend/app/graphrag
GRAPHRAG_DATA_DIR=data
GRAPHRAG_QUERY_TYPE=local
GRAPHRAG_RESPONSE_TYPE=text
GRAPHRAG_COMMUNITY_LEVEL=3
GRAPHRAG_DYNAMIC_COMMUNITY=false
